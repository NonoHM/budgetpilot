node_modules

# Output
.output
.vercel
.netlify
.wrangler
/.svelte-kit
/build

# OS
.DS_Store
Thumbs.db

# Env
.env
.env.*
!.env.example
!.env.test

# Reverse proxy: the operator's own Caddyfile (their real domain), built from
# Caddyfile.example which is the tracked template.
/Caddyfile

# Local databases and exports
*.db
*.db-journal
*.sqlite
*.sqlite3
*.csv
# Operator database dumps (docs/operations.md tells you to write them to ~/, this is
# the second layer). Anchored and prefixed rather than a blanket *.sql, which would
# swallow prisma/migrations/**/migration.sql.
*.dump
/budgetpilot-backup.*
*.7z
*.zip
*.xlsx
csv/
exports/
backups/
scr/

# Vite
vite.config.js.timestamp-*
vite.config.ts.timestamp-*
# Playwright
test-results
# e2e throwaway DB (also covered by *.db above, kept explicit for clarity) and storageState
# (contains a live session cookie for the e2e test account — never commit it).
/e2e/.data/
/e2e/.auth/

# Paraglide (généré)
/src/lib/paraglide/

# Prisma clients, one per provider, generated at build time by `npx prisma generate`
# (see the README kept inside, which is tracked on purpose).
/src/lib/server/database/generated/*
!/src/lib/server/database/generated/README.md

# Local credentials
docs/local/
keys/
*.pem

# Internal working notes (not for the public repo): audits, planning dumps and
# refactor reports written for me, not for readers of the repo. Some quote real
# database contents. Kept on disk, never tracked.
docs/architecture-audit.md
docs/Rapport Fusion Account.txt
docs/règles_filtre.txt
docs/regex-filter-plan.md
docs/responsive-consistency-audit.md
docs/i18n.md
docs/superpowers/

# Local-only agent instructions (public shared file is AGENTS.md)
/CLAUDE.md
# Per-machine Claude Code permissions (shared config is .claude/settings.json)
.claude/settings.local.json
