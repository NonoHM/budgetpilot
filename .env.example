# Local/non-Docker default. The Docker Compose setup overrides this to
# file:/data/dev.db (the container's persistent volume mount) automatically —
# you don't need to change this value for docker compose up.
DATABASE_URL="file:./dev.db"
NODE_ENV=production
# Token required to create an account via /register (1st user, or an
# already-logged-in admin afterwards). Generate with `openssl rand -base64 32`.
# Never commit the real value. A value ending in "=", or containing "+" or
# "/", is normal openssl output — paste it exactly as printed, it's not a
# copy mistake.
BOOTSTRAP_TOKEN=
# HMAC secret key dedicated to hashing the emails/IPs used by login rate
# limiting (LoginAttempt table). Distinct from BOOTSTRAP_TOKEN. Generate with
# `openssl rand -hex 32`. Never commit the real value.
RATE_LIMIT_HASH_SECRET=
# Registration mode. "admin_only" (default if absent): historical behavior —
# only the 1st user (bootstrap) or an already-logged-in admin can create an
# account, protected by BOOTSTRAP_TOKEN. "open": free self-registration, SaaS
# style — anyone with the /register URL can create an account.
# BOOTSTRAP_TOKEN becomes unused/ignored in "open" mode. Protected only by IP
# rate limiting (5 attempts/15min, no email required) — NO CAPTCHA, NO email
# verification. Enable knowingly, especially if PUBLIC_INSTANCE=true (a
# genuinely internet-exposed instance).
REGISTRATION_MODE=admin_only
# bcrypt cost factor for password hashing. Integer between 12 (default if
# absent) and 15 (capped). Never go below 12.
PASSWORD_HASH_COST=12
# AES-256-GCM encryption key dedicated to the TOTP secret (MFA) stored in the
# DB. 32 bytes in hex (64 characters). Distinct from RATE_LIMIT_HASH_SECRET
# and BOOTSTRAP_TOKEN. Generate with `openssl rand -hex 32`. Never commit the
# real value. Required as soon as the TOTP module loads (even if no user has
# enabled MFA yet).
TOTP_ENCRYPTION_KEY=
# Session lifetime in days (default 30 if absent).
SESSION_TTL_DAYS=30
# Lifetime in hours of a single-use invitation link generated from the admin
# panel (default 72 if absent).
INVITATION_TTL_HOURS=72
# Enable only if the instance is genuinely reachable over HTTPS from the
# outside (a real public deployment on the Internet). Forces the session
# cookie to Secure independently of NODE_ENV, so it never depends on a
# NODE_ENV that could be misconfigured. Do NOT enable on a local/LAN http://
# deployment — the browser would then reject the cookie.
PUBLIC_INSTANCE=false
PORT=3000
HOST=0.0.0.0
# Public origin the app is served from. adapter-node (SvelteKit) checks every
# form submission's Origin header against this value as CSRF protection — see
# https://svelte.dev/docs/kit/adapter-node#Environment-variables-ORIGIN-PROTOCOL_HEADER-HOST_HEADER-and-more
# Docker default: http://localhost:3000, matching docker-compose.yml's port
# mapping. If you remap the host port (e.g. "3001:3000" in docker-compose.yml's
# ports:), update this to the port you actually open in the browser (e.g.
# http://localhost:3001) — both must match, or every form submission (login,
# register, ...) fails with "Cross-site POST form submissions are forbidden".
ORIGIN=http://localhost:3000
BODY_SIZE_LIMIT=21000000
LLM_ENABLED=false
LLM_PROVIDER=ollama
LLM_BASE_URL=http://127.0.0.1:11434
LLM_MODEL=qwen2.5:0.5b
LLM_TIMEOUT_MS=10000
# Hosts allowed for LLM_BASE_URL, comma-separated.
# Default (absent/empty value): localhost,127.0.0.1,::1 (strictly local).
# This variable is NOT limited to local hosts: you can add a remote hostname
# (e.g. a personal VPS hosting Ollama). In Docker, use host.docker.internal to
# reach an Ollama running on the host machine.
# Adding a remote host means your aggregated financial data will leave your
# local network to transit to that server — enable only if you control and
# trust that server.
# Local hosts (localhost, 127.0.0.1, ::1) must use http:// (loopback).
# host.docker.internal (Docker's alias to the host machine, not a remote
# server) is also allowed over http://. Any other remote host added to this
# list must use https:// in LLM_BASE_URL — http:// is refused there to avoid
# sending your financial data in clear text over the network.
LLM_ALLOWED_HOSTS=localhost,127.0.0.1,::1
# Additional hosts allowed over http:// (on top of the localhost/127.0.0.1/
# ::1/host.docker.internal baseline), comma-separated. Useful for a trusted
# internal host where Ollama doesn't serve TLS (e.g. an "ollama" service
# co-located on the same Docker Compose network as the app). Do not use this
# for a genuinely remote host (prefer https:// via LLM_ALLOWED_HOSTS alone,
# without adding it here).
LLM_HTTP_PERMITTED_HOSTS=
# Automatic bank connection (Enable Banking). Opt-in: "true" to enable, any
# other value (or absence) = disabled (fail-safe). The app stays 100% usable
# in manual/CSV mode without ever enabling this option.
BANK_SYNC_ENABLED=false
# Hosts allowed for the bank provider's API, comma-separated.
# Default (absent/empty value): api.enablebanking.com (official Enable
# Banking API). Unlike the LLM allowlist, there is NO http:// exception here:
# banking data only ever transits over https, with no exception.
BANK_SYNC_ALLOWED_HOSTS=
# Enable Banking application id (Control Panel > Applications). Required for
# any real bank connection. Never logged, never exposed client-side.
ENABLE_BANKING_APP_ID=
# RSA private key (PKCS8, PEM) associated with the Enable Banking application
# — the key generated locally whose public part was uploaded to the Control
# Panel. Two MUTUALLY EXCLUSIVE options (both set at once = startup error,
# neither set with BANK_SYNC_ENABLED=true = clear error on the first call):
#  - ENABLE_BANKING_PRIVATE_KEY: inline PEM content, newlines encodable as
#    "\n";
#  - ENABLE_BANKING_PRIVATE_KEY_PATH: path to the PEM file (absolute, or
#    relative — resolved against cwd then the project root), e.g.
#    ./keys/enablebanking.pem. This file must NEVER be committed (keys/ and
#    *.pem are in .gitignore).
# SECRET: never logged, never committed. Without a key + app id, the Enable
# Banking connector refuses every call (the mock/demo mode doesn't need it).
ENABLE_BANKING_PRIVATE_KEY=
ENABLE_BANKING_PRIVATE_KEY_PATH=
# Catch-up window (days) for a connection's FIRST sync.
# Default: 90 (bounded 1..3650; an invalid value falls back to the default).
# Meant for sandbox datasets frozen in the past (Enable Banking's Mock ASPSP
# serves 2020-2021 entries) — only widens a single historical fetch, the 6h
# throttle (PSD2 budget) stays unchanged.
BANK_SYNC_FIRST_LOOKBACK_DAYS=
# Enable Banking API base URL. Default: https://api.enablebanking.com.
# Always validated against BANK_SYNC_ALLOWED_HOSTS (https only).
ENABLE_BANKING_BASE_URL=
# Allowlist of origins allowed for the bank consent callback URL (comma-
# separated list of full origins, e.g.
# "http://localhost:5173,http://127.0.0.1:5173"). The callback path is fixed:
# /imports/bank-connections/callback — it must EXACTLY match the URLs
# registered in the Enable Banking Control Panel.
# Fail-safe: unset = no bank connection flow can start.
BANK_SYNC_REDIRECT_ALLOWED_ORIGINS=
