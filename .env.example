# Which database engine to use: sqlite (default), postgresql, or mysql.
# "postgres" and "mariadb" are accepted too. Leave it unset for SQLite, which
# needs no server and keeps the whole database in one file you can copy. An
# unrecognized value stops the app at startup rather than silently falling
# back. See docs/configuration.md for the PostgreSQL and MySQL setup.
DATABASE_PROVIDER=sqlite
# Local/non-Docker default. The Docker Compose setup overrides this to
# file:/data/budgetpilot.db (the container's persistent volume mount) automatically —
# you don't need to change this value for docker compose up. With a server
# engine this is a full connection string, e.g.
# postgresql://budgetpilot:password@db:5432/budgetpilot
#
# A BARE `npm run build` NEEDS THIS IN THE ENVIRONMENT, and setting it in this
# file is not enough. Measured: with DATABASE_URL present in .env and absent
# from the shell, the build still stops with
#   Error: DATABASE_URL is required in production (set it in your environment)
# SvelteKit's post-build analysis imports the server modules in a forked process
# with NODE_ENV already forced to production, and src/lib/server/db.ts reads
# process.env directly, so it never sees a value that only lives here. Run
#   DATABASE_URL="file:./dev.db" npm run build
# or export it in your shell. `npm run dev` is unaffected (dev is not
# production, so the guard does not fire), CI sets it, and the e2e suite passes
# its own value to the server it starts, which is why none of them caught this.
DATABASE_URL="file:./dev.db"
# Password for the database server started by docker-compose.postgres.yml or
# docker-compose.mysql.yml. Only those two overlays read it; SQLite (the
# default) and a server you run yourself both ignore it — with your own
# server, the password lives inside DATABASE_URL instead. It has no default
# on purpose: the overlays refuse to start without it rather than publishing
# a database whose password is a value printed in this repository. Generate
# with `openssl rand -hex 32` — hex rather than base64 because the overlays
# splice this value into a connection string, where base64's "/" ends the
# host part and "+" can be read as a space: the server accepts the password
# and the app then cannot log in with it. Never commit the real value. See
# docs/database-providers.md.
DATABASE_PASSWORD=
# Matches what this file is for: a local checkout running `npm run dev`. Vite
# warns on every dev start if it reads NODE_ENV=production here, and the value
# is redundant for Docker anyway — docker-compose.yml sets NODE_ENV=production
# under `environment:`, which takes precedence over this file. Only set this to
# production for a bare-metal production run (`npm run build && node build`).
NODE_ENV=development
# Token required to create an account via /register (1st user, or an
# already-logged-in admin afterwards). Generate with `openssl rand -base64 32`.
# Never commit the real value. A value ending in "=", or containing "+" or
# "/", is normal openssl output — paste it exactly as printed, it's not a
# copy mistake. With REGISTRATION_MODE=admin_only (the default), the app
# refuses to start without it until a first admin account exists — rather
# than silently rejecting every registration as an invalid token the way it
# used to. Once you have an admin, leaving it blank is allowed and only
# logs a warning: registration then works through invitation links only.
BOOTSTRAP_TOKEN=
# HMAC secret key dedicated to hashing the emails/IPs used by login rate
# limiting (LoginAttempt table). Distinct from BOOTSTRAP_TOKEN. Generate with
# `openssl rand -hex 32`. Never commit the real value.
RATE_LIMIT_HASH_SECRET=
# Trusted reverse-proxy addresses, comma-separated IPs or CIDRs (IPv4/IPv6).
# Leave UNSET when the app is reached directly (the default): rate limiting then
# keys on the real socket peer. Set it ONLY when the app sits behind a reverse
# proxy, to that proxy's address/CIDR: X-Forwarded-For is then trusted, but only
# from a peer on this list, so a client that reaches the app any other way cannot
# forge its address to escape the per-IP limits (see docs/reverse-proxy.md, #219).
# Do NOT set ADDRESS_HEADER/XFF_DEPTH: the app validates the header itself and
# refuses to start if ADDRESS_HEADER is set. Example: TRUSTED_PROXIES=172.28.5.0/24
TRUSTED_PROXIES=
# Registration mode. "admin_only" (default if absent): historical behavior —
# only the 1st user (bootstrap) or an already-logged-in admin can create an
# account, protected by BOOTSTRAP_TOKEN. "open": free self-registration, SaaS
# style — anyone with the /register URL can create an account.
# BOOTSTRAP_TOKEN becomes unused/ignored in "open" mode. Protected only by IP
# rate limiting (5 attempts/15min, no email required) — NO CAPTCHA, NO email
# verification. Enable knowingly, especially if PUBLIC_INSTANCE=true (a
# genuinely internet-exposed instance).
REGISTRATION_MODE=admin_only
# bcrypt cost factor for password hashing. Integer between 12 (default if
# absent) and 15 (capped). Never go below 12.
PASSWORD_HASH_COST=12
# AES-256-GCM encryption key dedicated to the TOTP secret (MFA) stored in the
# DB. 32 bytes in hex (64 characters). Distinct from RATE_LIMIT_HASH_SECRET
# and BOOTSTRAP_TOKEN. Generate with `openssl rand -hex 32`. Never commit the
# real value. Required as soon as the TOTP module loads (even if no user has
# enabled MFA yet).
TOTP_ENCRYPTION_KEY=
# Session lifetime in days (default 30 if absent).
SESSION_TTL_DAYS=30
# Lifetime in hours of a single-use invitation link generated from the admin
# panel (default 72 if absent).
INVITATION_TTL_HOURS=72
# The single switch governing the Secure flag on the session cookie, and it is
# fail-secure: unset, empty, "true" or any typo all mean Secure. ONLY the
# literal value "false" turns it off. NODE_ENV is not consulted at all.
# Leave it alone (or set true) for anything served over https:// — including
# localhost, where browsers accept a Secure cookie over plain http anyway.
# Set it to false ONLY for a LAN-only instance reached over plain http:// at a
# non-localhost address (http://192.168.1.42:3000, http://budget.lan): browsers
# refuse a Secure cookie there, so leaving it on makes login impossible — you
# would log in and land straight back on the login page. Doing this on an
# internet-reachable instance means session cookies travel in clear text.
PUBLIC_INSTANCE=true
# Host-side port Docker Compose publishes the app on (docker-compose.yml's
# ports: "${APP_PORT:-3000}:3000"). Not used outside Docker. The container's
# own internal port always stays 3000 — only change this if 3000 is already
# taken on your machine. ORIGIN below follows it on its own: compose derives its
# default from this value, so on localhost you no longer keep the two in sync
# by hand.
APP_PORT=3000
PORT=3000
HOST=0.0.0.0
# Public origin the app is served from. adapter-node (SvelteKit) checks every
# form submission's Origin header against this value as CSRF protection — see
# https://svelte.dev/docs/kit/adapter-node#Environment-variables-ORIGIN-PROTOCOL_HEADER-HOST_HEADER-and-more
# It must be the EXACT URL you type in the browser: same protocol, same host,
# same port, no trailing slash. Get it wrong and every form submission (login,
# register, ...) fails with "Cross-site POST form submissions are forbidden"
# while every page still loads, so the failure waits for your first account.
#
# LEAVE THIS COMMENTED OUT if you reach the app at http://localhost — compose
# builds it from APP_PORT above, so changing the port is enough. SET IT when
# that is not the URL you type: a LAN address (http://192.168.1.42:3000), a
# hostname (http://budget.lan:3000), or anything behind a reverse proxy
# (https://budget.example.com). Compose knows the port because you just typed
# it; it cannot know the host.
#ORIGIN=https://budget.example.com
# Cap on the whole HTTP request body, applied by SvelteKit before any of the
# app's own code runs. Sized for the largest upload accepted: a BACKUP file
# on Settings > Restore, itself capped at 20 MB.
# It is NOT the limit on an imported statement. That one is 256,000 bytes,
# separate, and not configurable: raising this has no effect on it. Lowering
# this below 20 MB will break restoring a large backup.
BODY_SIZE_LIMIT=21000000
# OPTIONAL, and safe to delete: unset means 8, which is the measured default.
# Unlike TOTP_ENCRYPTION_KEY or BOOTSTRAP_TOKEN, leaving this out never stops
# the app, because it has a sensible default and guards no secret.
# How much XML an uploaded .xlsx may unpack to. A different quantity from the
# upload size: an .xlsx is a zip, so 205 KB on the wire can hold 260 MB once
# opened, and opening it costs the server about 760 MB of memory and nearly
# two seconds during which it answers nothing else. 8 is about 2.5x the
# largest workbook LibreOffice produced under the upload cap.
# 32 is a HARD CEILING: a higher value stops the app at startup instead of
# being silently reduced, because an import failing against a limit your own
# configuration says should not apply is worse than a refusal you can read.
# 32 is where a single parse reaches about 1s; the default 8 is 340ms.
# PER UPLOAD, not per server: nothing queues imports, and two 32 MB ones at
# once freeze the app for ~1s at a stretch. Several active users is a reason
# to leave this alone rather than raise it.
# Any value other than 8 is named in the startup log next to the default.
IMPORT_XLSX_MAX_UNCOMPRESSED_MB=8
# OPTIONAL, and safe to delete: unset means 2000000, the measured default.
# How many separate entries a backup may contain, counted BEFORE the file is
# opened. Size does not predict cost here: a 20 MB backup holding a real
# 40,559-transaction history costs ~132 MB to open, and a 20 MB file crafted
# to hold as many empty entries as possible costs ~801 MB, with the check
# that rejects it as not-a-backup running only after that is spent.
# 2000000 is a little over twice the 888,888 entries this app can itself put
# in a backup at the 20 MB limit. Set it lower and your OWN backups may be
# refused, and the user is told the file is too complex.
# 4000000 is a HARD CEILING: higher stops the app at startup rather than
# being silently reduced. ~214 MB worst case there, ~107 MB at the default.
BACKUP_MAX_JSON_NODES=2000000
# How many columns an imported statement may declare, checked before anything
# reads the file. Optional: leave it out and you get 512.
# NOT about parsing speed, which the 256 KB upload limit already bounds (27,000
# columns in one row parse in 28 ms). It bounds the designation screen, which
# draws one card per column with three sample values in each, so its cost is per
# column rather than per byte.
# 4096 is a HARD CEILING: higher stops the app at startup rather than being
# silently reduced.
CSV_MAX_COLUMNS=512
# How many remembered column mappings one account may keep. Optional: leave it
# out and you get 50. One is kept per distinct set of column names, so five banks
# with three format changes each is fifteen.
# Worth knowing: nothing deletes a remembered mapping yet, so until a screen for
# that exists this is the only thing bounding the table.
# 500 is a HARD CEILING, same rule as above.
COLUMN_MAPPINGS_PER_USER=50
LLM_ENABLED=false
LLM_PROVIDER=ollama
LLM_BASE_URL=http://127.0.0.1:11434
LLM_MODEL=qwen2.5:0.5b
# Budget for one generation. The old 10s default was below what a cold Ollama
# actually needs — the very first dashboard load after starting the stack has to
# load the model into memory, which alone can take longer than that, so the AI
# card reported itself unavailable on the one attempt most people ever make.
# The dashboard no longer waits on this (the advice streams in separately), so a
# generous value costs you nothing but a slightly later card.
LLM_TIMEOUT_MS=45000
# Budget for reaching Ollama at all, spent BEFORE the generation budget above and
# kept small on purpose. It asks one question: is something listening and speaking
# HTTP at LLM_BASE_URL. A stopped Ollama is therefore reported in about two seconds
# rather than costing the whole generation budget, which is what makes a generous
# LLM_TIMEOUT_MS safe: the long wait is only ever spent once something has answered.
# Raise it if your Ollama is on another machine over a slow link.
LLM_CONNECT_TIMEOUT_MS=2000
# Hosts allowed for LLM_BASE_URL, comma-separated.
# Default (absent/empty value): localhost,127.0.0.1,::1 (strictly local).
# This variable is NOT limited to local hosts: you can add a remote hostname
# (e.g. a personal VPS hosting Ollama). In Docker, use host.docker.internal to
# reach an Ollama running on the host machine.
# Adding a remote host means your aggregated financial data will leave your
# local network to transit to that server — enable only if you control and
# trust that server.
# Local hosts (localhost, 127.0.0.1, ::1) must use http:// (loopback).
# host.docker.internal (Docker's alias to the host machine, not a remote
# server) is also allowed over http://. Any other remote host added to this
# list must use https:// in LLM_BASE_URL — http:// is refused there to avoid
# sending your financial data in clear text over the network.
LLM_ALLOWED_HOSTS=localhost,127.0.0.1,::1
# Additional hosts allowed over http:// (on top of the localhost/127.0.0.1/
# ::1/host.docker.internal baseline), comma-separated. Useful for a trusted
# internal host where Ollama doesn't serve TLS (e.g. an "ollama" service
# co-located on the same Docker Compose network as the app). Do not use this
# for a genuinely remote host (prefer https:// via LLM_ALLOWED_HOSTS alone,
# without adding it here).
LLM_HTTP_PERMITTED_HOSTS=
# Automatic bank connection (Enable Banking). Opt-in: "true" to enable, any
# other value (or absence) = disabled (fail-safe). The app stays 100% usable
# in manual/CSV mode without ever enabling this option.
BANK_SYNC_ENABLED=false
# Hosts allowed for the bank provider's API, comma-separated.
# Default (absent/empty value): api.enablebanking.com (official Enable
# Banking API). Unlike the LLM allowlist, there is NO http:// exception here:
# banking data only ever transits over https, with no exception.
BANK_SYNC_ALLOWED_HOSTS=
# Enable Banking application id (Control Panel > Applications). Required for
# any real bank connection. Never logged, never exposed client-side.
# THE APPLICATION MUST ALSO BE ACTIVE. A PRODUCTION application is created
# Inactive, and until you activate it (Control Panel > "Activate by linking
# accounts", or request unrestricted activation) every call answers HTTP 403
# "Application is not active", including the bank list, so no bank can even be
# picked. The app reports that as "The bank list is unavailable right now" and
# logs nothing.
ENABLE_BANKING_APP_ID=
# RSA private key (PKCS8, PEM) associated with the Enable Banking application
# (the key generated locally whose CERTIFICATE was uploaded to the Control
# Panel). Two MUTUALLY EXCLUSIVE options (both set at once = startup error):
#  - ENABLE_BANKING_PRIVATE_KEY: inline PEM content, newlines encodable as
#    "\n";
#  - ENABLE_BANKING_PRIVATE_KEY_PATH: path to the PEM file (absolute, or
#    relative — resolved against cwd then the project root), e.g.
#    ./keys/enablebanking.pem. This file must NEVER be committed (keys/ and
#    *.pem are in .gitignore).
# NEITHER SET, OR THE FILE UNREADABLE, IS A SILENT FAILURE. There is no clear
# error and nothing is written to the logs: the bank list reports itself
# unavailable and actions report "Invalid operation.", for a condition that no
# retry can change. Do not diagnose this from the logs; docs/bank-sync.md has
# the checks that actually distinguish the causes.
# IN DOCKER, the path is resolved INSIDE the container and no BASE compose file
# mounts keys/. Add the docker-compose.keys.yml overlay, or use the inline form,
# and make the file readable by uid 65532. The host listing does not answer
# that question. Both forms work under read_only: true (the key is only read).
# SECRET: never logged, never committed. Without a key + app id, the Enable
# Banking connector refuses every call (the mock/demo mode doesn't need it).
ENABLE_BANKING_PRIVATE_KEY=
ENABLE_BANKING_PRIVATE_KEY_PATH=
# Catch-up window (days) for a connection's FIRST sync.
# Default: 90 (bounded 1..3650; an invalid value falls back to the default).
# Meant for sandbox datasets frozen in the past (Enable Banking's Mock ASPSP
# serves 2020-2021 entries) — only widens a single historical fetch, the 6h
# throttle (PSD2 budget) stays unchanged.
BANK_SYNC_FIRST_LOOKBACK_DAYS=
# Enable Banking API base URL. Default: https://api.enablebanking.com.
# Always validated against BANK_SYNC_ALLOWED_HOSTS (https only).
ENABLE_BANKING_BASE_URL=
# Allowlist of origins allowed for the bank consent callback URL (comma-
# separated list of full origins, e.g.
# "http://localhost:5173,http://127.0.0.1:5173"). The callback path is fixed:
# /imports/bank-connections/callback — it must EXACTLY match the URLs
# registered in the Enable Banking Control Panel.
# THREE PLACES MUST AGREE CHARACTER FOR CHARACTER, protocol and port included:
# this variable, ORIGIN, and the redirect URL registered in the Control Panel.
# Behind a TLS proxy on 443 that origin carries NO port (https://host, not
# https://host:3000, which are different origins, and the second looks right).
# Only a mismatch HERE names itself on screen; a mismatch in the Control Panel
# shows the generic "Invalid operation." and a wrong ORIGIN shows a bare 403.
# Fail-safe: unset = no bank connection flow can start.
BANK_SYNC_REDIRECT_ALLOWED_ORIGINS=
