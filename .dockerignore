node_modules
.svelte-kit
build
.git
# Every .env and .env.*, at ANY depth: a bare pattern here matches only at the context root. The
# temporary file scripts/env-file.mjs leaves if it is killed between open and rename holds the
# secrets, and so can a .env.local, a .env.production or the .env of a checkout nested in this one;
# the builder's `COPY . .` would put any of them in a layer. Nothing in the image build reads
# .env.example or .env.test, so neither is kept.
**/.env
**/.env.*
# Agent tooling, including .claude/worktrees/, which holds other checkouts of this repository with
# their own .env files. Nothing under .claude is read by the image build.
.claude
*.db
dev.db
prisma/dev.db
coverage
.DS_Store

# Generated Prisma clients: build output, regenerated by `npm run db:generate` in the builder
# stage. Copying a developer's local copy in first would let any file the generator does not
# overwrite survive into the image, making its contents depend on an untracked working tree.
src/lib/server/database/generated
