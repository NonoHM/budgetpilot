{
	"name": "budgetpilot",
	"private": true,
	"license": "Apache-2.0",
	"version": "1.2.0",
	"type": "module",
	"scripts": {
		"setup": "node scripts/setup.mjs",
		"dev": "vite dev",
		"dev:ai": "node scripts/ensure-ollama.mjs && vite dev",
		"setup:llm": "node scripts/ensure-ollama.mjs --pull",
		"seed:dev": "node scripts/seed-dev.mjs",
		"db:normalize-names": "node scripts/normalize-names.mjs",
		"db:generate": "node scripts/generate-prisma-clients.mjs",
		"db:schemas": "node scripts/generate-prisma-schemas.mjs",
		"db:schemas:check": "node scripts/generate-prisma-schemas.mjs --check",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "(svelte-kit sync && npm run paraglide:compile) || echo ''",
		"paraglide:compile": "paraglide-js compile --project ./project.inlang --outdir ./src/lib/paraglide --strategy cookie preferredLanguage baseLocale",
		"check": "svelte-kit sync && npm run paraglide:compile && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"lint:tracked": "node scripts/lint-tracked.mjs",
		"format": "prettier --write .",
		"test:unit": "vitest",
		"test:sandbox": "vitest run --config vitest.sandbox.config.ts",
		"test:db": "vitest run --config vitest.db.config.ts",
		"test": "npm run test:unit -- --run && npm run test:e2e",
		"test:e2e": "playwright install chromium && playwright test"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@inlang/paraglide-js": "^2.29.3",
		"@playwright/test": "^1.64.1",
		"@sveltejs/adapter-node": "^5.2.13",
		"@sveltejs/kit": "^2.70.3",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@tailwindcss/forms": "^0.5.11",
		"@tailwindcss/typography": "^0.5.19",
		"@tailwindcss/vite": "^4.3.3",
		"@types/bcrypt": "^6.0.0",
		"@types/node": "^24.19.2",
		"@types/qrcode": "^1.5.6",
		"@vitest/browser-playwright": "^5.0.5",
		"eslint": "^10.13.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.23.1",
		"fast-check": "^4.10.2",
		"fflate": "^0.8.3",
		"globals": "^17.13.0",
		"playwright": "^1.64.1",
		"prettier": "^3.9.10",
		"prettier-plugin-svelte": "^4.1.0",
		"prettier-plugin-tailwindcss": "^0.8.1",
		"svelte": "^5.57.3",
		"svelte-check": "^4.7.7",
		"tailwindcss": "^4.3.0",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.72.1",
		"vite": "^8.3.5",
		"vitest": "^5.0.5",
		"vitest-browser-svelte": "^3.1.0"
	},
	"overrides": {
		"@tailwindcss/typography": {
			"postcss-selector-parser": "^6.1.5"
		},
		"cookie": "^0.7.2",
		"deepmerge-ts": "^8.0.0",
		"mariadb": "^3.5.4",
		"mysql2": "^3.24.3"
	},
	"dependencies": {
		"@prisma/adapter-better-sqlite3": "^7.10.1",
		"@prisma/adapter-mariadb": "^7.10.1",
		"@prisma/adapter-pg": "^7.10.1",
		"@prisma/client": "^7.10.1",
		"bcrypt": "^6.0.0",
		"bits-ui": "^2.19.5",
		"jose": "^6.2.12",
		"ollama": "^0.6.4",
		"otpauth": "^9.5.2",
		"pino": "10.4.0",
		"prisma": "^7.10.1",
		"qrcode": "^1.5.4",
		"re2js": "^2.8.7",
		"read-excel-file": "^9.2.0",
		"zod": "^4.6.6"
	},
	"allowScripts": {
		"better-sqlite3@12.11.1": true,
		"@prisma/engines@7.10.0": true,
		"bcrypt@6.0.0": true,
		"prisma@7.10.0": true
	}
}
