{
	"name": "budgetpilot",
	"private": true,
	"license": "Apache-2.0",
	"version": "0.1.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"dev:ai": "node scripts/ensure-ollama.mjs && vite dev",
		"setup:llm": "node scripts/ensure-ollama.mjs --pull",
		"seed:dev": "node scripts/seed-dev.mjs",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "(svelte-kit sync && npm run paraglide:compile) || echo ''",
		"paraglide:compile": "paraglide-js compile --project ./project.inlang --outdir ./src/lib/paraglide --strategy cookie preferredLanguage baseLocale",
		"check": "svelte-kit sync && npm run paraglide:compile && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"test:unit": "vitest",
		"test:sandbox": "vitest run --config vitest.sandbox.config.ts",
		"test": "npm run test:unit -- --run && npm run test:e2e",
		"test:e2e": "playwright install chromium && playwright test"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@inlang/paraglide-js": "^2.20.2",
		"@playwright/test": "^1.60.0",
		"@sveltejs/adapter-node": "^5.2.13",
		"@sveltejs/kit": "^2.69.2",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@tailwindcss/forms": "^0.5.11",
		"@tailwindcss/typography": "^0.5.19",
		"@tailwindcss/vite": "^4.3.3",
		"@types/bcrypt": "^6.0.0",
		"@types/node": "^24",
		"@types/qrcode": "^1.5.6",
		"@vitest/browser-playwright": "^4.1.8",
		"eslint": "^10.4.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.19.0",
		"fflate": "^0.8.3",
		"globals": "^17.6.0",
		"playwright": "^1.60.0",
		"prettier": "^3.8.3",
		"prettier-plugin-svelte": "^4.1.0",
		"prettier-plugin-tailwindcss": "^0.8.0",
		"prisma": "^7.8.0",
		"svelte": "^5.56.1",
		"svelte-check": "^4.6.0",
		"tailwindcss": "^4.3.0",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.60.1",
		"vite": "^8.0.16",
		"vitest": "^4.1.8",
		"vitest-browser-svelte": "^2.1.1"
	},
	"overrides": {
		"cookie": "^0.7.2"
	},
	"dependencies": {
		"@prisma/adapter-better-sqlite3": "^7.8.0",
		"@prisma/client": "^7.8.0",
		"bcrypt": "^6.0.0",
		"better-sqlite3": "^11.10.0",
		"bits-ui": "^2.18.1",
		"jose": "^6.2.3",
		"ollama": "^0.6.3",
		"otpauth": "^9.5.1",
		"qrcode": "^1.5.4",
		"re2js": "^2.8.6",
		"read-excel-file": "^9.2.0",
		"zod": "^4.4.3"
	}
}
