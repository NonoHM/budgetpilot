{
	"name": "budgetpilot",
	"private": true,
	"license": "Apache-2.0",
	"version": "0.14.2",
	"type": "module",
	"scripts": {
		"setup": "node scripts/setup.mjs",
		"dev": "vite dev",
		"dev:ai": "node scripts/ensure-ollama.mjs && vite dev",
		"setup:llm": "node scripts/ensure-ollama.mjs --pull",
		"seed:dev": "node scripts/seed-dev.mjs",
		"db:normalize-names": "node scripts/normalize-names.mjs",
		"db:generate": "node scripts/generate-prisma-clients.mjs",
		"db:schemas": "node scripts/generate-prisma-schemas.mjs",
		"db:schemas:check": "node scripts/generate-prisma-schemas.mjs --check",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "(svelte-kit sync && npm run paraglide:compile) || echo ''",
		"paraglide:compile": "paraglide-js compile --project ./project.inlang --outdir ./src/lib/paraglide --strategy cookie preferredLanguage baseLocale",
		"check": "svelte-kit sync && npm run paraglide:compile && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"lint:tracked": "node scripts/lint-tracked.mjs",
		"format": "prettier --write .",
		"test:unit": "vitest",
		"test:sandbox": "vitest run --config vitest.sandbox.config.ts",
		"test:db": "vitest run --config vitest.db.config.ts",
		"test": "npm run test:unit -- --run && npm run test:e2e",
		"test:e2e": "playwright install chromium && playwright test"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@inlang/paraglide-js": "^2.24.1",
		"@playwright/test": "^1.62.1",
		"@sveltejs/adapter-node": "^5.2.13",
		"@sveltejs/kit": "^2.70.3",
		"@sveltejs/vite-plugin-svelte": "^7.3.0",
		"@tailwindcss/forms": "^0.5.11",
		"@tailwindcss/typography": "^0.5.19",
		"@tailwindcss/vite": "^4.3.3",
		"@types/bcrypt": "^6.0.0",
		"@types/node": "^24",
		"@types/qrcode": "^1.5.6",
		"@vitest/browser-playwright": "^4.1.11",
		"eslint": "^10.8.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.23.0",
		"fast-check": "^4.9.0",
		"fflate": "^0.8.3",
		"globals": "^17.11.0",
		"playwright": "^1.60.0",
		"prettier": "^3.9.6",
		"prettier-plugin-svelte": "^4.1.0",
		"prettier-plugin-tailwindcss": "^0.8.1",
		"svelte": "^5.56.10",
		"svelte-check": "^4.7.6",
		"tailwindcss": "^4.3.0",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.67.0",
		"vite": "^8.2.2",
		"vitest": "^4.1.10",
		"vitest-browser-svelte": "^2.1.1"
	},
	"overrides": {
		"cookie": "^0.7.2",
		"deepmerge-ts": "^8.0.0",
		"mariadb": "^3.5.3"
	},
	"dependencies": {
		"@prisma/adapter-better-sqlite3": "^7.9.1",
		"@prisma/adapter-mariadb": "^7.9.1",
		"@prisma/adapter-pg": "^7.9.1",
		"@prisma/client": "^7.9.1",
		"bcrypt": "^6.0.0",
		"bits-ui": "^2.19.0",
		"jose": "^6.2.10",
		"ollama": "^0.6.3",
		"otpauth": "^9.5.1",
		"prisma": "^7.9.1",
		"qrcode": "^1.5.4",
		"re2js": "^2.8.6",
		"read-excel-file": "^9.2.0",
		"zod": "^4.4.3"
	}
}
