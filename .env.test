# Dedicated to the Playwright e2e suite (npm run test:e2e) ONLY. Every value below is a
# fake, test-only secret generated for this file — never a value copied from the real .env
# (which holds actual dev secrets and must never be committed). DATABASE_URL is NOT set here on
# purpose: it's injected by e2e/config.ts (E2E_ENV) so it always points at the throwaway
# e2e/.data/test.db, never at dev.db / prisma/dev.db.
REGISTRATION_MODE=admin_only
PASSWORD_HASH_COST=12
BOOTSTRAP_TOKEN=e2e-fake-bootstrap-token-do-not-reuse
RATE_LIMIT_HASH_SECRET=a568355e366f0357277140d4c134488166718e5167b95cedf386be187a7a59df
TOTP_ENCRYPTION_KEY=6e028638d80f09ae156eb174909e3e11fc4610c1156263729b946765963ff45a
PUBLIC_INSTANCE=false
LLM_ENABLED=false
SESSION_TTL_DAYS=1
# The import pages allow 60 uploads per 15 minutes per account and address, and this whole suite
# is ONE account on ONE address. A full run on main recorded 59 IMPORT attempts (count of
# LoginAttempt rows with kind IMPORT in e2e/.data/test.db after the run), so the next import spec
# would have tripped the limiter. Every new spec that uploads to an import page grows that figure,
# at about 5 per spec file today (59 over 11 files, arithmetic rather than a per-file measurement).
# 180 is three times the measured spend: room for about two dozen more such files before this
# needs revisiting, and below the 240 ceiling in src/lib/server/auth/rateLimit.ts, which refuses
# to boot above it. Test configuration only: production keeps 60 unless an operator sets this.
IMPORT_RATE_LIMIT_MAX_ATTEMPTS=180
